  "decor.cottagecoreliving.candle_sconce.desc": "A wall sconce with a little drip dish. Hangs on any wall.",
  "decor.cottagecoreliving.candlestick.desc": "A tall taper in a brass chamberstick.",
  "decor.cottagecoreliving.cottage_table.desc": "A sturdy table for showing off decorations. Dress it with a tablecloth; tables side by side join up.",
  "decor.cottagecoreliving.cuckoo_clock.desc": "A carved chalet clock. A little bird calls out every hour.",
  "decor.cottagecoreliving.curtains.desc": "Hang them in front of a window. Right-click to tie them back. Stack them for tall windows.",
  "decor.cottagecoreliving.daffodil_pot.desc": "Sunny daffodils in a terracotta pot.",
  "decor.cottagecoreliving.dried_flowers.desc": "Flowers hung upside down to dry, tied with twine.",
  "decor.cottagecoreliving.egg_basket.desc": "Pastel painted eggs nestled in straw.",
  "decor.cottagecoreliving.embroidery_hoop.desc": "A finished piece of embroidery, stitched with the set's motif.",
  "decor.cottagecoreliving.fairy_door.desc": "A tiny door for the base of a tree or a garden wall. Knock and see who answers.",
  "decor.cottagecoreliving.firefly_jar.desc": "A jar of gentle glowing fireflies. Stand it on a table or hang it up.",
  "decor.cottagecoreliving.flower_basket.desc": "A wicker basket overflowing with the set's flowers.",
  "decor.cottagecoreliving.flower_crown.desc": "A crown of woven flowers with trailing ribbons, left on a table.",
  "decor.cottagecoreliving.flower_vase.desc": "A painted vase with a fresh bouquet in the set's flowers.",
  "decor.cottagecoreliving.flower_wheelbarrow.desc": "A little painted wheelbarrow turned into a flower planter.",
  "decor.cottagecoreliving.fruit_platter.desc": "Watermelon slices, strawberries and grapes on a white platter.",
  "decor.cottagecoreliving.garden_gloves.desc": "A pair of patterned gardening gloves, left out after weeding.",
  "decor.cottagecoreliving.garden_gnome.desc": "A cheerful gnome to keep an eye on the vegetable patch.",
  "decor.cottagecoreliving.garden_lantern.desc": "A candle lantern for paths and porches. Right-click to light it; hang it from a ceiling.",
  "decor.cottagecoreliving.garden_sign.desc": "A painted sign on a stake. Right-click to pick one of eight pictures.",
  "decor.cottagecoreliving.garden_tool_rack.desc": "A trowel, a hand fork and pruners hung up on pegs.",
  "decor.cottagecoreliving.hanging_planter.desc": "A pot on knotted cords with flowers trailing over the edge. Hang it from a ceiling or a beam.",
  "decor.cottagecoreliving.hot_cocoa.desc": "Mugs of cocoa topped with marshmallows. Place more mugs for friends.",
  "decor.cottagecoreliving.jam_jars.desc": "Homemade jam with gingham lids. Place more to line up a row.",
  "decor.cottagecoreliving.jewelry_box.desc": "Opens with a little chime to show a mirror and a string of pearls.",
  "decor.cottagecoreliving.leaf_pile.desc": "A rustling heap of autumn leaves. Place more to pile it higher; walk through it!",
  "decor.cottagecoreliving.lemonade_pitcher.desc": "Fresh lemonade with lemon slices, and a glass poured ready.",
  "decor.cottagecoreliving.mantel_clock.desc": "A little arched clock for a shelf or mantelpiece.",
  "decor.cottagecoreliving.mason_jar.desc": "A glass jar full of something sweet or useful.",
  "decor.cottagecoreliving.mini_fountain.desc": "A two-tier fountain that splashes away. Fill glass bottles from it.",
  "decor.cottagecoreliving.mini_snowman.desc": "A little snowman in a knitted scarf. He never melts indoors.",
  "decor.cottagecoreliving.open_book.desc": "Left open at a favourite page. Right-click to read a line.",
  "decor.cottagecoreliving.painted_rock.desc": "A smooth pebble painted with the set's motif.",
  "decor.cottagecoreliving.picnic_basket.desc": "A wicker hamper lined with gingham. Holds nine things for the picnic.",
  "decor.cottagecoreliving.picnic_blanket.desc": "Lay several side by side: they join into one big blanket with a fringed border.",
  "decor.cottagecoreliving.pillar_candles.desc": "Chunky pillar candles. Light them with flint and steel; place more to make a cluster.",
  "decor.cottagecoreliving.pine_garland.desc": "A pine swag strung with tiny twinkling lights.",
  "decor.cottagecoreliving.potted_herbs.desc": "Kitchen herbs in a terracotta pot, with a little name tag.",
  "decor.cottagecoreliving.pumpkin_stack.desc": "Little pumpkins and gourds. Place more to stack them up.",
  "decor.cottagecoreliving.seasonal_centerpiece.desc": "A table centerpiece: tulips, lemons, little pumpkins or pine and candles, by season.",
  "decor.cottagecoreliving.seasonal_doormat.desc": "A woven doormat with a tulip, a sun, a leaf or a snowflake.",
  "decor.cottagecoreliving.seasonal_garland.desc": "A garland that dresses itself for the season.",
  "decor.cottagecoreliving.seasonal_tree.desc": "A potted tree that blossoms, fruits, turns gold and wears snow through the year.",
  "decor.cottagecoreliving.seasonal_wreath.desc": "Blossoms in spring, lemons in summer, acorns in autumn and holly in winter.",
  "decor.cottagecoreliving.seed_packets.desc": "A little crate of colourful seed packets, sorted for planting day.",
  "decor.cottagecoreliving.snow_globe.desc": "A tiny snowy cottage under glass. Right-click to shake it.",
  "decor.cottagecoreliving.stacked_books.desc": "A cosy pile of well-loved books. Place more on top to stack them higher.",
  "decor.cottagecoreliving.standing_frame.desc": "A little frame on an easel back. Right-click to swap the picture.",
  "decor.cottagecoreliving.stepping_stones.desc": "Flat stones to set into a lawn or a flower bed.",
  "decor.cottagecoreliving.stone_cairn.desc": "Balanced stones. Place more to build it taller.",
  "decor.cottagecoreliving.sun_hat.desc": "A wide straw hat with a ribbon band and a flower tucked in.",
  "decor.cottagecoreliving.teacups.desc": "Two cups of tea on saucers, with a little silver spoon.",
  "decor.cottagecoreliving.teapot.desc": "Right-click to brew a fresh pot. Wisps of steam rise from the spout.",
  "decor.cottagecoreliving.toadstools.desc": "A ring of painted toadstools, just right for a fairy garden.",
  "decor.cottagecoreliving.tool_bucket.desc": "A galvanised bucket stuffed with trowels and forks, gloves over the rim.",
  "decor.cottagecoreliving.trinket_box.desc": "A fabric-lidded box with room for nine little treasures.",
  "decor.cottagecoreliving.tulip_crate.desc": "A wooden crate of tulips fresh from the market.",
  "decor.cottagecoreliving.vanity_mirror.desc": "A small round mirror on a stand, for a dressing table.",
  "decor.cottagecoreliving.wall_clock.desc": "Its hands follow the time of day. Right-click to read the time.",
  "decor.cottagecoreliving.wall_frame.desc": "Holds one of eight little paintings. Right-click to swap the picture.",
  "decor.cottagecoreliving.wall_mirror.desc": "Right-click to check your reflection. It always has something nice to say.",
  "decor.cottagecoreliving.wall_plates.desc": "A trio of hand-painted plates for a cottage kitchen wall.",
  "decor.cottagecoreliving.wall_shelf.desc": "A floating shelf with a jar, a tiny plant and two books.",
  "decor.cottagecoreliving.watering_can.desc": "An enamel watering can. Right-click to water the crops in front of it.",
  "decor.cottagecoreliving.wind_chime.desc": "Rings softly in the breeze, more often when it rains. Right-click to ring it.",
  "decor.cottagecoreliving.window_box.desc": "A painted planter for under a window, with ivy spilling over the front.",
  "decor.cottagecoreliving.winter_lantern.desc": "A dark iron lantern with snow on its cap and a sprig of pine.",
  "decor.cottagecoreliving.winter_wreath.desc": "Pine and holly berries with a red velvet bow, dusted with snow.",
